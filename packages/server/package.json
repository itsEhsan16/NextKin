{
  "name": "@nextkin/server",
  "version": "0.1.0",
  "private": true,
  "description": "The NextKin backend: HTTP API (mounted by apps/web), worker, migrations. Node-only — never imported by @nextkin/shared or the mobile app.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./next": "./src/next.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "worker": "tsx watch --env-file-if-exists=../../.env src/entrypoints/worker.ts",
    "build": "node build.mjs",
    "db:types": "kysely-codegen --dialect postgres --url \"env(DATABASE_OWNER_URL)\" --env-file ../../.env --default-schema app --include-pattern \"app.*\" --out-file src/db/types.generated.ts",
    "db:types:check": "kysely-codegen --dialect postgres --url \"env(DATABASE_OWNER_URL)\" --env-file ../../.env --default-schema app --include-pattern \"app.*\" --out-file src/db/types.generated.ts --verify",
    "openapi": "tsx src/entrypoints/openapi.ts",
    "openapi:check": "tsx src/entrypoints/openapi.ts --check",
    "eval": "tsx --env-file-if-exists=../../.env evals/run.ts",
    "eval:assistant": "tsx --env-file-if-exists=../../.env evals/runAssistant.ts",
    "dlq": "tsx --env-file-if-exists=../../.env src/entrypoints/dlq.ts",
    "drills": "vitest run --project drills",
    "render-check": "tsx --env-file-if-exists=../../.env src/entrypoints/render-check.ts",
    "fixtures:jobs": "tsx src/entrypoints/write-job-fixtures.ts",
    "load:users": "tsx --env-file-if-exists=../../.env src/entrypoints/load-users.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "~0.133.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-sqs": "^3.1149.0",
    "@aws-sdk/s3-presigned-post": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@hono/zod-openapi": "^1.6.3",
    "@nextkin/engines": "workspace:*",
    "@nextkin/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "docx": "~9.7.2",
    "fast-xml-parser": "^5.11.2",
    "fflate": "~0.8.3",
    "hono": "^4.13.13",
    "iovalkey": "^0.4.0",
    "jose": "^6.2.12",
    "jszip": "3.10.2",
    "kysely": "^0.29.6",
    "nodemailer": "^10.1.0",
    "pdfjs-dist": "~6.4.299",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "playwright-core": "1.63.0",
    "server-only": "^0.0.1",
    "tesseract.js": "~7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  }
}
