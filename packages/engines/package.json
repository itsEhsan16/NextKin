{
  "name": "@nextkin/engines",
  "version": "0.1.0",
  "private": true,
  "description": "Pure, deterministic engines (timeline, normalizer, ledgers, rubric, lint). No I/O, no clock, no randomness, no Intl: safe on the phone and identical on the server.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  }
}
