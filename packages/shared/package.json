{
  "name": "@nextkin/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Domain models, mock fixtures, repositories and query hooks shared by @nextkin/mobile and @nextkin/web.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./models": "./src/models/index.ts",
    "./models/*": "./src/models/*.ts",
    "./mock": "./src/mock/index.ts",
    "./mock/fixtures": "./src/mock/fixtures/index.ts",
    "./mock/fixtures/*": "./src/mock/fixtures/*.ts",
    "./mock/*": "./src/mock/*.ts",
    "./repos": "./src/repos/index.ts",
    "./repos/*": "./src/repos/*.ts",
    "./queries": "./src/queries/index.ts",
    "./queries/*": "./src/queries/*.ts",
    "./schemas": "./src/schemas/index.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./auth": "./src/auth/index.ts",
    "./scoring/*": "./src/scoring/*.ts",
    "./jobs/*": "./src/jobs/*.ts",
    "./interview/*": "./src/interview/*.ts",
    "./assistant/*": "./src/assistant/*.ts",
    "./privacy/*": "./src/privacy/*.ts",
    "./tailor/*": "./src/tailor/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nextkin/engines": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  }
}
