# Pinned versions for the local stack, CI and the server image (ImBackendImplementationPlan L6).
# docker-compose.yml and every workflow read versions from this file; nothing uses `latest`.
# Each value was looked up on 2026-10-10 (Docker Hub, GitHub releases, npm). Re-check a pin before
# raising it, and record the change in toreview.md. CI adds digests on top of these tags (P1-10).

# --- Runtime -----------------------------------------------------------------------------------
# Node 24 LTS in the server image. Server code stays Node 22-compatible until the repo pin
# (22.17.0 in apps/mobile/eas.json and the workflows) moves. [verify Expo SDK 57 + EAS on 24]
NODE_IMAGE=node:24.21.0-bookworm-slim

# --- core profile ------------------------------------------------------------------------------
# PostgreSQL major 17 is the single pin from doc/decisions/appendix-c/pinned-versions.md.
POSTGRES_IMAGE=postgres:17.11-bookworm
# Valkey 8 to match ElastiCache Serverless for Valkey. [verify the engine version ElastiCache offers]
VALKEY_IMAGE=valkey/valkey:8.1.10
# S3 stand-in. MinIO's community images are gone; P1-04's presigned-POST size test confirms this
# choice or falls back to RUSTFS_IMAGE, then a pinned Chainguard MinIO image.
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48
RUSTFS_IMAGE=rustfs/rustfs:1.0.1
ELASTICMQ_IMAGE=softwaremill/elasticmq-native:1.7.1
MAILPIT_IMAGE=axllent/mailpit:v1.31.4

# --- opt-in profiles (ask before pulling: L6) --------------------------------------------------
CLAMAV_IMAGE=clamav/clamav:1.5.4
MOCK_OAUTH2_IMAGE=ghcr.io/navikt/mock-oauth2-server:6.0.5
OTEL_LGTM_IMAGE=grafana/otel-lgtm:0.36.0
STRIPE_MOCK_IMAGE=stripe/stripe-mock:v0.206.0

# --- test tooling ------------------------------------------------------------------------------
K6_IMAGE=grafana/k6:2.3.0
ZAP_IMAGE=zaproxy/zap-stable:2.17.0

# --- library majors (installed per package; recorded here so every pin lives in one place) -----
# Each must typecheck under the repo's TypeScript ~6.0.3 before it lands. [verify per library]
LIB_HONO=4.13
LIB_HONO_ZOD_OPENAPI=1.6
LIB_ZOD=4.6
LIB_KYSELY=0.29
LIB_KYSELY_CODEGEN=0.20
LIB_PG=8.23
LIB_IOVALKEY=0.4
LIB_PINO=10.4
LIB_OTEL_SDK_NODE=0.223
LIB_AWS_SDK_V3=3.1149
LIB_ANTHROPIC_SDK=0.133
LIB_NODE_RS_ARGON2=2.2
LIB_PDFJS_DIST=6.4
LIB_MAMMOTH=1.13
LIB_DOCX=9.7
LIB_TESSERACT_JS=7.0
# Exact: the Chromium build downloaded into the worker image must match the library version.
LIB_PLAYWRIGHT=1.63.0
LIB_VITEST=5.0
LIB_TESTCONTAINERS=12.2
LIB_FAST_CHECK=4.10
LIB_TSX=4.23

# --- CI tools (downloaded and checksum-verified in backend-ci.yml) ---------------------------
SQUAWK_VERSION=2.68.0
SQUAWK_LINUX_X64_SHA256=53070672cbe0b8adce55372931d4435cc2395edd8b5736819a82e483b08d4d09
OASDIFF_VERSION=1.33.0
OASDIFF_LINUX_AMD64_SHA256=43a4e328e2d13ba1552d760aa68d2485c75c5621f309f6ff64ae895188345247

# P13-01 security scans (run on demand: pnpm scan:secrets, pnpm scan:deps).
GITLEAKS_IMAGE=zricethezav/gitleaks:v8.24.0
OSV_SCANNER_IMAGE=ghcr.io/google/osv-scanner:v2.0.0

# --- LaTeX compile service (the `latex` profile, toreview §111) ---------------------------------
# Tectonic's static musl build, checksum-verified in docker/Dockerfile's `latex` target. Digests
# looked up 2026-10-19 on the GitHub release (tectonic@0.17.0) and recomputed after download.
# The TeX files come from Tectonic's default bundle (TeX Live 2022), cached at image build time.
TECTONIC_VERSION=0.17.0
TECTONIC_SHA256_X86_64=8533d07f9ccbd7a65824b9e0459041bca34af1eb33daba48f59215593753a3b7
TECTONIC_SHA256_AARCH64=b10954a95404f3ab2328d2fa59a5ebab8e657f893fab096f98be8db7c0c979b8
