# Copy to .env for local development: `cp .env.example .env`. .env is gitignored.
# Every value here is a local stand-in; nothing in this file is a real secret.
# The server validates these at start-up and names every missing or invalid one
# (packages/server/src/config).

APP_ENV=local
LOG_LEVEL=info

# --- Database: the app role is not the table owner and cannot bypass row-level security ---
DATABASE_URL=postgres://nextkin_app:app_local@127.0.0.1:5432/nextkin
# Used only by `pnpm migrate`
DATABASE_OWNER_URL=postgres://nextkin_owner:owner_local@127.0.0.1:5432/nextkin
# Purge and sweep jobs (withSystem), and staff reads (withStaff)
DATABASE_MAINTENANCE_URL=postgres://nextkin_maintenance:maintenance_local@127.0.0.1:5432/nextkin
DATABASE_READONLY_URL=postgres://nextkin_readonly:readonly_local@127.0.0.1:5432/nextkin
# Local superuser for the volume seed only. Refused in staging and production.
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/nextkin

VALKEY_URL=redis://127.0.0.1:6379

# --- AWS SDK pointed at the local stand-ins (L1). Unset these in the cloud. ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=nextkin_local
AWS_SECRET_ACCESS_KEY=nextkin_local_secret
S3_ENDPOINT=http://127.0.0.1:8333
S3_FORCE_PATH_STYLE=true
S3_BUCKET_UPLOADS=nextkin-uploads
SQS_ENDPOINT=http://127.0.0.1:9324

SMTP_URL=smtp://127.0.0.1:1025

# --- Identity (P4). Local IdP + Mailpit codes; Google/Apple come from mock-oauth2-server
# (`pnpm stack:up -- --profile auth`). In staging/production these come from Cognito (X-07).
EMAIL_FROM=NextKin <no-reply@nextkin.test>
# Public base of this API; providers redirect to <it>/api/v1/auth/callback.
API_PUBLIC_URL=http://localhost:3000
# App redirects the federated hand-off may target. exp:// (Expo Go) is refused outside local.
MOBILE_REDIRECT_ALLOWLIST=nextkin://,exp://
FEDERATION_GOOGLE_ISSUER=http://127.0.0.1:8090/google
FEDERATION_APPLE_ISSUER=http://127.0.0.1:8090/apple
FEDERATION_CLIENT_ID=nextkin-local
FEDERATION_CLIENT_SECRET=local-secret

# --- Adapters (refused in staging/production when they are local stand-ins: L3) ---
IDENTITY_ADAPTER=local
SCAN_ADAPTER=clamav
OCR_ADAPTER=tesseract
EMAIL_ADAPTER=smtp
# recorded = replay fixtures, no network. claudeDirect = live calls with your own key (D-23):
# synthetic data only, and set a spend limit in the Anthropic Console as well.
LLM_ROUTE=recorded
# ANTHROPIC_API_KEY=
# openrouter = the same Claude models through your OpenRouter key; same rules as claudeDirect.
# OPENROUTER_API_KEY=
# --- Uploads, scanning and parsing (P7). ClamAV needs: pnpm stack:up -- --profile core --profile scan
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# S3_BUCKET_ANONYMOUS=nextkin-anonymous-uploads
# UPLOAD_MAX_BYTES=5242880      # 5 MB per document
# AVATAR_MAX_BYTES=2097152      # 2 MB per photo
# PARSE_TIMEOUT_MS=20000        # the isolated parser thread's wall-clock limit
# PARSE_HEAP_MB=256             # and its heap ceiling
# TEASER_PER_IP_PER_HOUR=5
# AI_DAILY_CAP_USD=2          # D-23: stop live calls past this much per developer per day (UTC); P9's golden runs use 10
# Run the golden set live (synthetic data only): pnpm eval -- --live
# AI_DEVELOPER=your-name      # whose spend the cap counts
# AI_RECORD=false             # with claudeDirect: write each live answer as a fixture
# WORKER_CONCURRENCY=4
# GENERATION_TIMEOUT_SECONDS=180
# Documents and export (P10). The worker renders PDFs with Chromium: in the container Playwright's
# own build is used; locally, point at a downloaded Chromium (e.g. ms-playwright/chromium-1234).
# S3_BUCKET_EXPORTS=nextkin-exports
# CHROMIUM_PATH=C:/Users/<you>/AppData/Local/ms-playwright/chromium-1234/chrome-win64/chrome.exe
JOBS_ADAPTER=fixture
# LaTeX export (toreview §111): the sealed compile service, `pnpm stack:up -- --profile latex`,
# reached through its relay on 127.0.0.1:8790. stack:up writes a random token to
# docker/latex/dev.token (gitignored); point the worker at that file. The path is read relative to
# the process's working directory (`pnpm worker` runs in packages/server), so give it absolute.
# LATEX_COMPILER_URL=http://127.0.0.1:8790
# LATEX_COMPILER_TOKEN_FILE=F:/path/to/NextKin/docker/latex/dev.token
# Job links (toreview §144.3): `pnpm dev:all` starts the link reader on your Chromium (CHROMIUM_PATH).
# Run on its own, `pnpm --filter @nextkin/server link-reader` and the worker both need this absolute
# path; `pnpm stack:up` writes the file. Without it a link fails with a plain message.
# LINK_READER_TOKEN_FILE=F:/path/to/NextKin/docker/link-reader/dev.token

# Billing (P12). `fake` signs its own webhooks and serves a local checkout page; `stripeMock` is the
# Stripe adapter against stripe-mock (the `pay` profile, request shapes only); `stripe` (test mode,
# X-13) needs both keys. Never put a live key here.
PAYMENT_ADAPTER=fake
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Where support tickets go (Mailpit shows them locally), and where provider keys entered in the
# admin portal are kept (`local` is Valkey, a stand-in; Secrets Manager at X-05).
# SUPPORT_INBOX=support@nextkin.test
SECRETS_ADAPTER=local
# S3_BUCKET_AUDIT=nextkin-audit-archive

WORKER_HEARTBEAT_SECONDS=30

# --- Optional host-port overrides for docker-compose.yml ---
# POSTGRES_PORT=5432
# VALKEY_PORT=6379
# S3_PORT=8333
# SQS_PORT=9324

# --- API kernel (P3) ---
APP_ORIGIN=http://localhost:3000
# Local only: more browser origins to trust (comma-separated; one * per DNS label), e.g. a
# Cloudflare quick tunnel. Refused on staging and production (toreview §131.10).
# APP_EXTRA_ORIGINS=https://*.trycloudflare.com
# Signs pagination cursors. Any 32+ random characters locally; generate a fresh one per environment.
CURSOR_SECRET=local-cursor-secret-change-me-0000000000
# Local only: Next sets X-Forwarded-For from the socket. The cloud uses cloudfront-viewer-address.
TRUSTED_IP_HEADER=x-forwarded-for
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# --- Apps on the backend (P5) ---
# Unset (or mock), the apps run on the mock data layer exactly as before. `http` sends every
# repository the backend serves to it; a list such as `user,profile` flips only those.
# Web reads these at build/dev time; sign in at /dev/sign-in with a seeded account.
# NEXT_PUBLIC_DATA_SOURCE=http
# NEXT_PUBLIC_API_BASE_URL=          # empty: same origin (the default)
# Mobile reads EXPO_PUBLIC_DATA_SOURCE and EXPO_PUBLIC_API_BASE_URL from apps/mobile/.env.local
# (see aws/setup/04-local-development.md, "Running the apps on the backend").
